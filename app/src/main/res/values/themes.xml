<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ComponentActivity + Compose does not need an AppCompat theme; this only
         has to supply a sane window background and drop the platform ActionBar. -->
    <style name="Theme.App" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
